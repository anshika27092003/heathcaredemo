# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- SMTP (Gmail example: use an App Password, not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your_app_password_here
# Optional: defaults to SMTP_USER if omitted
SMTP_FROM=your.address@gmail.com

# --- Inbound mail (IMAP). Defaults match Gmail; omit these to reuse SMTP_USER / SMTP_PASSWORD above.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_MAILBOX=INBOX
# Optional: socket timeout in seconds for connect/login/fetch (default 45, max 300)
# IMAP_TIMEOUT=60
# IMAP_USER=your.address@gmail.com
# IMAP_PASSWORD=your_app_password_here

# --- Google Document AI (OCR for attachments) ---
# Path to service account JSON (do not commit this file).
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json
# Optional if project_id is inside the JSON:
# GCP_PROJECT_ID=your-gcp-project
# Processor region (must match where the processor was created):
DOCUMENT_AI_LOCATION=us
# Document AI processor ID (or add "processor_id" to the JSON — non-standard field):
DOCUMENT_AI_PROCESSOR_ID=your_processor_id

# Optional overrides for the template
# EMAIL_SUBJECT=Document Submission Request
# EMAIL_BODY=Dear Provider,\n\nPlease submit your updated credentialing documents for verification.\n\nRegards,\nAdmin Team
