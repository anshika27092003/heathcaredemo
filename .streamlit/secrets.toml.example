# Copy to `.streamlit/secrets.toml` for local runs, or paste this structure into
# Streamlit Community Cloud: App settings → Secrets.
#
# Values here are placeholders — replace with real credentials. Never commit `secrets.toml`.

# --- SMTP (Gmail: use an App Password) ---
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "your.address@gmail.com"
SMTP_PASSWORD = "your_app_password_here"
SMTP_FROM = "your.address@gmail.com"

# --- IMAP (optional; defaults shown — omit to reuse SMTP_USER / SMTP_PASSWORD) ---
IMAP_HOST = "imap.gmail.com"
IMAP_PORT = "993"
IMAP_MAILBOX = "INBOX"
IMAP_TIMEOUT = "45"
# IMAP_USER = "your.address@gmail.com"
# IMAP_PASSWORD = "your_app_password_here"

# --- Google Document AI ---
GCP_PROJECT_ID = "your-gcp-project-id"
DOCUMENT_AI_LOCATION = "us"
DOCUMENT_AI_PROCESSOR_ID = "your_processor_id"

# Alternative (works on Streamlit Cloud): put the service account fields in a nested
# table — the app converts it to JSON. Keys may be lower_snake_case; they are mapped
# to UPPER_SNAKE in the environment. Optional ``processor_id`` inside the table fills
# DOCUMENT_AI_PROCESSOR_ID if that env var is unset.
#
# document_ai_processor_id = "your_processor_id"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project"
# private_key_id = "..."
# private_key = """-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"""
# client_email = "...@....iam.gserviceaccount.com"
# ...

# On Streamlit Cloud you usually cannot upload a JSON file path. Paste the full
# service account JSON below (as a single TOML multi-line string). The app writes
# it to a temp file and sets GOOGLE_APPLICATION_CREDENTIALS automatically.
# If you run locally with a file instead, set GOOGLE_APPLICATION_CREDENTIALS only
# and you can omit GOOGLE_SERVICE_ACCOUNT_JSON.
#
# GOOGLE_SERVICE_ACCOUNT_JSON = """
# {
#   "type": "service_account",
#   "project_id": "...",
#   ...
# }
# """

# Optional: local file path instead of GOOGLE_SERVICE_ACCOUNT_JSON (ignored on Cloud if JSON is set).
# GOOGLE_APPLICATION_CREDENTIALS = "/path/to/service-account.json"

# --- Optional email template overrides ---
# EMAIL_SUBJECT = "Document Submission Request"
# EMAIL_BODY = """Dear Provider,

# Please submit your updated credentialing documents for verification.

# Regards,
# Admin Team"""
